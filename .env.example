EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Public URL where the Expo API routes are hosted.
# In development, the app can infer localhost from Expo.
# In production mobile builds, set this to your EAS Hosting URL.
EXPO_PUBLIC_API_BASE_URL=

# Internal test-only admin login. This is bundled in the client; do not use as real production auth.
EXPO_PUBLIC_INTERNAL_ADMIN_PASSWORD=1234567890

# Server-side only. Configure this in EAS env or local .env for `npx expo serve`.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=ImpactoEJ <onboarding@resend.dev>
